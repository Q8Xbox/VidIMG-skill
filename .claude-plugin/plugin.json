{
  "name": "vidimg",
  "displayName": "VidIMG – faithful photo & video restoration",
  "version": "0.2.0",
  "description": "Restore personal photos and videos faithfully (upscale, denoise, deinterlace) with free open models, Video2X and AviSynth+/VapourSynth. Every result is checked by a fidelity guard: faces, colours, frames, audio and aspect must stay the same. Windows + NVIDIA GPU.",
  "author": {
    "name": "Q8Xbox"
  },
  "repository": "https://github.com/Q8Xbox/VidIMG-skill",
  "license": "Apache-2.0",
  "keywords": [
    "photo",
    "video",
    "restoration",
    "upscale",
    "deinterlace",
    "denoise",
    "ffmpeg",
    "video2x"
  ],
  "skills": "./.claude/skills/",
  "commands": "./.claude/commands/",
  "mcpServers": {
    "vidimg": {
      "command": "python",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/vidimg/mcp_server.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/vidimg/hooks/pretool.py\"",
            "timeout": 10,
            "statusMessage": "VidIMG media-safety check"
          }
        ]
      }
    ]
  }
}
